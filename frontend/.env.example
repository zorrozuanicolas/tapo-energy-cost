# Optional. Copy to .env.local to change a value; the defaults work for local development.

# Backend URL when the API is on another origin. Leave it unset in development: the Vite server
# forwards /api to http://localhost:8000.
# VITE_API_URL=https://backend.example.com

# Time zone the screen uses to decide what "today" is. It must match the backend's TIMEZONE.
# VITE_TIMEZONE=America/Montevideo
