# Copy this file to `.env` (ignored by git) and adjust. Every setting has a default,
# so only change what you need. Values here are the defaults.

# IANA time zone of the plugs' owner; hour boundaries and tariff bands use it.
TIMEZONE=America/Montevideo

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# SQLAlchemy URL of the database; `sqlite+aiosqlite` selects the async SQLite driver.
DATABASE_URL=sqlite+aiosqlite:///data/tapo.db

# Folder with tariffs.yaml, holidays.yaml and outlets.yaml, relative to backend/.
CONFIG_DIR=../config

# Days to keep raw power readings; hourly totals are kept forever. Must be greater than 0.
RAW_RETENTION_DAYS=60

# Longest gap in seconds between two samples that still counts as continuous; a longer gap
# (an outage) adds no energy. Keep it a few times the polling interval. Must be greater than 0.
MAX_GAP_SECONDS=60

# Seconds between two readings of each plug. Must be greater than 0, and MAX_GAP_SECONDS
# must be at least twice this value.
POLL_INTERVAL_SECONDS=10

# true: fake plugs, nothing touches the network. false: poll the real plugs, which needs the
# credentials below. Never poll real plugs from two machines at once.
TAPO_MOCK=true

# false: run only the API, without reading any plug.
POLLER_ENABLED=true

# Days of fake hourly history to create at startup when the database has no energy data yet, for
# demos. 0 turns it off; the most is 1100. It needs TAPO_MOCK=true.
SEED_DEMO_DAYS=0

# Tapo account used to log in to the plugs. Placeholders: put the real values only in your `.env`.
TAPO_USERNAME=you@example.com
TAPO_PASSWORD=change-me

# Browser origins allowed to call the API, as a JSON list. Only needed in development, when the
# frontend dev server runs on another port.
CORS_ORIGINS=["http://localhost:5173"]
