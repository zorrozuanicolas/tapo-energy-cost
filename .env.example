# Settings for Docker Compose. Copy this file to `.env` (ignored by git) and adjust.
# Without a .env file the app runs with mock plugs and these defaults.
# (For `uv run` without Docker, use backend/.env instead.)

# true: fake plugs, nothing touches the network. false: poll the real plugs, which needs the
# credentials below. Never poll real plugs from two machines at once.
TAPO_MOCK=true

# Tapo account used to log in to the plugs. Placeholders: put the real values only in your `.env`.
# Keep the single quotes: without them Docker Compose treats a `$` in the password as a variable.
TAPO_USERNAME=you@example.com
TAPO_PASSWORD='change-me'

# IANA time zone of the plugs' owner, for the backend and the dashboard. After changing it, rebuild:
# docker compose up -d --build
TIMEZONE=America/Montevideo

# One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Days of fake history to create when the database has no energy data yet, for demos. 0 turns it
# off. It needs TAPO_MOCK=true.
SEED_DEMO_DAYS=0

# Port of the dashboard on this machine.
FRONTEND_PORT=8080

# Only for remote access (`docker compose --profile tunnel up -d`): the token of your Cloudflare
# Tunnel. It is a secret. Protect the public address with Cloudflare Access: the app has no login.
TUNNEL_TOKEN=

# Linux only: send the containers' logs to the systemd journal instead of Docker's own files.
# COMPOSE_FILE=docker-compose.yml:docker-compose.journald.yml
